# Copy to config/rag.env (gitignored). Variables already set in the environment take precedence.

# --- Models (served by Ollama) -------------------------------------------------------------------
TEXT_MODEL=qwen3:4b-instruct-2507
# Embeddings, retrieval and the optional cross-encoder belong to the paper library (paper-fetch):
# set PAPER_FETCH_EMBED_MODEL and PAPER_FETCH_RERANK_MODEL in ~/.config/paper-fetch/*.env.
# Loopback only: Ollama has no authentication.
OLLAMA_HOST=127.0.0.1:11434

# --- Your own endpoint (optional) -----------------------------------------------------------------
# Any OpenAI-compatible chat API for the text model; embeddings and the verifier stay local. See
# docs/research-pipeline.md "Your own endpoint". PIPELINE_LLM (command line) and PIPELINE_MCP_LLM
# (research tool) default to auto: this endpoint when it is set, else Ollama / the calling model.
# One MCP run can still use the calling assistant: research_start(..., model="client").
PIPELINE_LLM=auto
PIPELINE_ENDPOINT_URL=
# qwen/qwen3.8-27b is the tested default; moonshotai/kimi-k3 for important questions.
PIPELINE_ENDPOINT_MODEL=
# The key itself, or a file holding it. Keep it out of this file if you copy it anywhere.
PIPELINE_ENDPOINT_KEY_FILE=
PIPELINE_ENDPOINT_REASONING=off
PIPELINE_ENDPOINT_ZDR=1
# OpenRouter: try the cheapest zero-retention provider first (price | throughput | latency | empty).
PIPELINE_ENDPOINT_SORT=price
# Hosts that do not report cost: USD per million tokens, "input,output" (Near AI is looked up).
PIPELINE_ENDPOINT_PRICE=
# Near AI direct instead of OpenRouter:
#   PIPELINE_ENDPOINT_URL=https://cloud-api.near.ai/v1
#   PIPELINE_ENDPOINT_MODEL=Qwen/Qwen3.8-27B

# A verifier from a DIFFERENT model family than the text model; comma-separate several. Every
# verifier must accept a claim. Empty = the text model checks its own claims, and answers say so.
# bespoke-minicheck is a trained grounding classifier (note its CC BY-NC licence).
PIPELINE_VERIFIER_MODEL=bespoke-minicheck:latest
# explore | grounded | publication. Publication refuses to run without an independent verifier.
PIPELINE_STRICTNESS=grounded
# Reranking is the paper library's cross-encoder (PAPER_FETCH_RERANK_MODEL); nothing to set here.
# Set explicitly: Ollama's default context can be ~4K tokens, and overflow is truncated silently.
PIPELINE_NUM_CTX=16384
# Most tokens one structured call may generate; a call that hits it fails alone, not the run.
PIPELINE_MAX_OUTPUT_TOKENS=2048
# Ollama unloads an idle model after 5 minutes by default; a run then pays to reload it.
PIPELINE_OLLAMA_KEEP_ALIVE=30m

# --- Behind the MCP server ---------------------------------------------------------------------
# Who does the pipeline's model steps: auto = your endpoint when set, else the calling model;
# client = the calling model (Claude, ChatGPT); endpoint; ollama = local.
PIPELINE_MCP_LLM=auto
# Longest a pipeline tool call waits before returning, and most tasks handed out per turn.
PIPELINE_CLIENT_TURN_WAIT=40
PIPELINE_CLIENT_BATCH=12
# Runs one pipeline server carries at once (several chats researching at the same time), and how
# long a run's client may go without calling before the run counts as abandoned and is ended.
PIPELINE_MAX_RUNS=4
PIPELINE_CLIENT_IDLE=600

# --- Storage -------------------------------------------------------------------------------------
PIPELINE_DATA_DIR=data/pipeline
PIPELINE_RUNS_DIR=runs
PIPELINE_AGENT_PROFILES_DIR=../scientific-research-agents
# Optional local private researcher extensions; keep the path in gitignored config/rag.env.
PIPELINE_AGENT_EXTENSIONS_DIR=

# GitHub repository MCP. Authentication stays in `gh`'s credential store. Writes only create
# agent/* branches and pull requests; the tool cannot merge or write a default branch.
GITHUB_MCP_ORGS=polarizetech
GITHUB_MCP_ALLOW_WRITE=1
# Optional: a token for this tool alone instead of `gh`'s login. Make a fine-grained token limited
# to the repositories it may change, with Contents and Pull requests read/write and Metadata read,
# and no Workflows permission. Keep it outside any repository, e.g. ~/.config/<you>/github-agent.token
# with mode 600, and give its path here.
# GITHUB_MCP_TOKEN_FILE=

# --- Domain --------------------------------------------------------------------------------------
# The field whose rules a run applies. Empty = generic. Install one first
# (uv pip install -e domains/<slug>); list them with `research-pipeline domains`. See docs/DOMAINS.md.
# Shipped: cardiovascular | respiratory | vestibular | neuroscience
PIPELINE_DOMAIN=
# A paper-library collection to search, fetch into and retrieve from. Empty = the whole index.
PIPELINE_COLLECTION=

# --- Budgets -------------------------------------------------------------------------------------
# An online run fetches open-access papers INTO the paper library. This bounds that write.
PIPELINE_MAX_FETCH=12
PIPELINE_MAX_SUBQUESTIONS=4
PIPELINE_MAX_ROUNDS=2
PIPELINE_SEARCH_CONCURRENCY=4
PIPELINE_FETCH_CONCURRENCY=4
# Sent to Crossref's polite pool during retraction checks. Empty = send nothing.
PIPELINE_CONTACT_EMAIL=

# --- MCP gateway ---------------------------------------------------------------------------------
# Keep the HTTP gateway on loopback. scripts/mcp-start.sh refuses any other bind unless
# MCP_ALLOW_PUBLIC_BIND=1 is set. Stdio clients (Claude Desktop, Claude Code) need no port at all.
MCP_HOST=127.0.0.1
MCP_PORT=8891
MCP_CONFIG=config/mcp-gateway.json
MCP_TOKEN_FILE=config/.mcp-token
